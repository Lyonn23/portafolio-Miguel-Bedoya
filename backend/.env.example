# Copia este archivo como ".env" (en la misma carpeta backend/) y completa
# tus datos reales. Sin esto, el formulario seguirá guardando los mensajes
# en mensajes.json, pero NO te llegará el email.

PORT=3000

# --- Envío de email por Gmail ---
# 1. Usa una cuenta de Gmail (puede ser la misma beleonnm@gmail.com u otra).
# 2. Activa la verificación en 2 pasos en esa cuenta: https://myaccount.google.com/security
# 3. Genera una "contraseña de aplicación" aquí: https://myaccount.google.com/apppasswords
#    (elige app "Correo" y dispositivo "Otro", te da un código de 16 letras)
# 4. Pega ese código abajo en GMAIL_APP_PASSWORD (NO tu contraseña normal de Gmail)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# A dónde llegan los mensajes del formulario (ya viene configurado a tu correo)
CONTACT_TO=beleonnm@gmail.com
